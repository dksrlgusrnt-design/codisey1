[32m+[m
[32m+[m[32m## 7.6 Bind Mount 개념 이해[m
[32m+[m
[32m+[m[32mBind Mount는 호스트 PC의 특정 디렉터리를 컨테이너 내부 디렉터리와 직접 연결하는 기능이다.[m
[32m+[m
[32m+[m[32m### Bind Mount 구조[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32m호스트 PC                         Docker 컨테이너[m
[32m+[m[32mdocker-web-bind/[m
[32m+[m[32m    │[m
[32m+[m[32m    └── html/[m
[32m+[m[32m         └── index.html[m
[32m+[m[32m              │[m
[32m+[m[32m              │ Bind Mount[m
[32m+[m[32m              ▼[m
[32m+[m[32m                         /usr/share/nginx/html/[m
[32m+[m[32m                                  │[m
[32m+[m[32m                                  └── index.html[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### Bind Mount의 특징[m
[32m+[m
[32m+[m[32m- 호스트 PC의 파일을 컨테이너 내부와 공유할 수 있다.[m
[32m+[m[32m- 호스트에서 파일을 수정하면 컨테이너에서도 변경된 내용을 확인할 수 있다.[m
[32m+[m[32m- Docker 이미지를 다시 빌드하지 않아도 파일 변경 사항을 반영할 수 있다.[m
[32m+[m[32m- `:ro` 옵션을 사용하면 컨테이너에서 해당 마운트 경로를 읽기 전용으로 사용할 수 있다.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## 7.7 Bind Mount 프로젝트 파일 확인[m
[32m+[m
[32m+[m[32m### 디렉터리 이동[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mcd ~/codisey1/docker-web-bind[m
[32m+[m[32m# Bind Mount 실습용 프로젝트 디렉터리로 이동[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 파일 구조 확인[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mls -R[m
[32m+[m[32m# 현재 디렉터리와 하위 디렉터리의 파일 목록 확인[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 실제 프로젝트 구조[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mdocker-web-bind/[m
[32m+[m[32m└── html/[m
[32m+[m[32m    └── index.html[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## 7.8 Bind Mount 컨테이너 실행[m
[32m+[m
[32m+[m[32m호스트의 HTML 디렉터리를 Nginx 컨테이너 내부 웹 디렉터리와 연결한다.[m
[32m+[m
[32m+[m[32m### 실행 명령어[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mdocker run -d \[m
[32m+[m[32m  --name codyssey-bind \[m
[32m+[m[32m  -p 8081:80 \[m
[32m+[m[32m  -v "$(pwd)/html:/usr/share/nginx/html:ro" \[m
[32m+[m[32m  nginx:alpine[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 명령어별 설명[m
[32m+[m
[32m+[m[32m| 명령어 | 의미 |[m
[32m+[m[32m|---|---|[m
[32m+[m[32m| `docker run` | 컨테이너 생성 및 실행 |[m
[32m+[m[32m| `-d` | 백그라운드 실행 |[m
[32m+[m[32m| `--name codyssey-bind` | 컨테이너 이름 지정 |[m
[32m+[m[32m| `-p 8081:80` | 호스트 8081 포트와 컨테이너 80 포트 연결 |[m
[32m+[m[32m| `-v` | 호스트 디렉터리와 컨테이너 디렉터리 연결 |[m
[32m+[m[32m| `$(pwd)/html` | 현재 위치의 html 디렉터리 |[m
[32m+[m[32m| `/usr/share/nginx/html` | 컨테이너 내부 Nginx 웹 디렉터리 |[m
[32m+[m[32m| `:ro` | 읽기 전용으로 연결 |[m
[32m+[m[32m| `nginx:alpine` | 실행할 Docker 이미지 |[m
[32m+[m
[32m+[m[32m### 명령어 사용 이유[m
[32m+[m
[32m+[m[32m- `-d`: 터미널을 점유하지 않고 백그라운드에서 실행하기 위해 사용한다.[m
[32m+[m[32m- `-p`: 호스트와 컨테이너의 포트를 연결하기 위해 사용한다.[m
[32m+[m[32m- `-v`: 호스트의 HTML 파일을 컨테이너와 공유하기 위해 사용한다.[m
[32m+[m[32m- `$(pwd)`: 현재 작업 디렉터리의 실제 경로를 자동으로 가져오기 위해 사용한다.[m
[32m+[m[32m- `:ro`: 컨테이너에서 호스트 원본 파일을 수정하지 못하도록 읽기 전용으로 설정한다.[m
[32m+[m
[32m+[m[32m### 컨테이너 실행 상태 확인[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mdocker ps[m
[32m+[m[32m# 실행 중인 컨테이너 및 포트매핑 확인[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 실제 실행 결과[m
[32m+[m
[32m+[m[32m| 컨테이너 | 이미지 | 호스트 포트 | 컨테이너 포트 | 상태 |[m
[32m+[m[32m|---|---|---|---|---|[m
[32m+[m[32m| codyssey-web | codyssey-web:v1 | 8080 | 80 | Up |[m
[32m+[m[32m| codyssey-bind | nginx:alpine | 8081 | 80 | Up |[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## 7.9 Bind Mount 웹 서버 접속 테스트[m
